%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db474e8e112c10847814ea2e331724ac, type: 3}
  m_Name: Dialogue_Fase1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  defaultVoiceSound: {fileID: 0}
  lines:
  - speaker: Erika
    text: "Voc\xEA \xE9 nova aqui n\xE3o \xE9?\r\nDeixe-me lhe explicar como as coisas
      funcionam por aqui"
    portrait: {fileID: 21300000, guid: c2e464f41b20a81408129e310059d713, type: 3}
    voiceSound: {fileID: 0}
    pitchVariance: 0.1
  - speaker: Erika
    text: "Esse ponto vermelho \xE9 sua vida, n\xE3o deixe nada encostar nele. Use
      WASD para se mover e protege-lo"
    portrait: {fileID: 21300000, guid: c2e464f41b20a81408129e310059d713, type: 3}
    voiceSound: {fileID: 0}
    pitchVariance: 0.1
  - speaker: Erika
    text: "Para tocar sua m\xFAsica e acertar seus oponentes, mire com o cursor neles\r\n"
    portrait: {fileID: 21300000, guid: c2e464f41b20a81408129e310059d713, type: 3}
    voiceSound: {fileID: 0}
    pitchVariance: 0.1
  - speaker: Erika
    text: "Acertar seus oponentes e sobreviver pela fase lhe dar\xE1 pontos, tomar
      dano reduzir\xE1 eles, v\xE1 atr\xE1s do m\xE1ximo de pontos que conseguir\r\n"
    portrait: {fileID: 21300000, guid: c2e464f41b20a81408129e310059d713, type: 3}
    voiceSound: {fileID: 0}
    pitchVariance: 0.1
  - speaker: Erika
    text: "Agora sem mais enrola\xE7\xE3o, vamos tocar!"
    portrait: {fileID: 21300000, guid: c2e464f41b20a81408129e310059d713, type: 3}
    voiceSound: {fileID: 0}
    pitchVariance: 0.1
